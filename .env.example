# Copie ce fichier en ".env" et renseigne tes propres valeurs.
# Ne commite jamais le fichier ".env" (il contient des secrets).

# --- Base de données PostgreSQL ---
# Format : postgres://utilisateur:motdepasse@hote:5432/nom_de_la_base
DATABASE_URL=postgres://preventisassur:changeme@localhost:5432/preventisassur

# --- Sécurité ---
# Génère une valeur aléatoire longue, par ex. avec : openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# --- Serveur ---
PORT=3000
NODE_ENV=production

# --- Compte admin créé par "npm run seed" (à changer immédiatement après la 1ère connexion) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=Direction Preventisassur
